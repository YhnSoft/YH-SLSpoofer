{
  "_readme": "复制本文件为 config.json 后按需修改。config.json 已在 .gitignore 中，不会进版本库。",

  "game_dir": "",
  "_game_dir_note": "留空则自动探测 Steam 库；也可填绝对路径，支持 %USERPROFILE% 之类的环境变量",

  "probe_seconds": 300,
  "_probe_seconds_note": "侦察模式（spawn_probe.py）的观察窗口，单位秒",

  "js": {
    "hwid_patch.js": {
      "onlyFromModule": "SL-AC\\.dll",
      "logBudget": 80,
      "mask": {
        "enabled": true,
        "keepStart": 3,
        "keepEnd": 2
      },
      "identity": {
        "systemSerial": "EXAMPLE000000001",
        "boardSerial": "EXAMPLE0001",
        "chassisSerial": "EXAMPLE000000001",
        "_systemUuid_note": "16 个 0-255 的十进制整数，按内存字节顺序排列；生成方法见 README 的 systemUuid 一节",
        "systemUuid": [
          0, 17, 34, 51, 68, 85, 102, 119,
          136, 153, 170, 187, 204, 221, 238, 255
        ]
      }
    },

    "hwid_probe.js": {
      "targetModule": "SL-AC\\.dll",
      "logBudget": 1200,
      "dumpTable": false,
      "maskSecrets": true
    }
  }
}
